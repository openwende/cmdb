# 复制为 .env 后填写；.env 已加入 .gitignore，不会被提交

# 大模型（DeepSeek）
DEEPSEEK_API_KEY=sk-your-deepseek-key
# 可选：deepseek-flash（V4.1 Flash，默认）、deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash

# Go CMDB 后端（本地 docker compose）
CMDB_BASE_URL=http://localhost:8080
CMDB_MCP_URL=http://localhost:8080/mcp

# 会话 / 检查点存储：复用本地 CMDB 的 PostgreSQL，表放在独立 schema
DATABASE_URL=postgresql://cmdb:password@localhost:5432/cmdb
AI_DB_SCHEMA=ai

# 评测脚本登录用的本地演示账号（由 cmdb-server 的演示数据脚本写入）
CMDB_EVAL_USERNAME=chenjing
CMDB_EVAL_PASSWORD=

# 可选：Agent 护栏，括号里是默认值
# AGENT_MODEL_CALL_LIMIT=15        # 单次提问最多调用模型次数
# AGENT_TOOL_CALL_LIMIT=25         # 单次提问最多调用工具次数
# SUMMARIZE_TRIGGER_TOKENS=60000   # 对话历史超过后压缩成摘要
# SUMMARIZE_KEEP_MESSAGES=20       # 压缩时保留最近的消息条数

# 可选：每天的提问次数限额（按 QUOTA_TIMEZONE 的日期算，0 表示不限）
# CHAT_DAILY_LIMIT_PER_USER=30     # 每个账号；公开演示账号是大家共用的
# CHAT_DAILY_LIMIT_TOTAL=200       # 全站合计
# QUOTA_TIMEZONE=Asia/Shanghai

# 可选：知识库检索（search_knowledge）。先运行 uv run python -m cmdb_ai.knowledge_store 入库；
# 本地模型 bge-m3、bge-reranker-v2-m3 首次运行会从 Hugging Face 下载（各约 2.3GB）
# KNOWLEDGE_SEARCH_MODE=rerank     # rerank（默认）| hybrid | vector，后两种只用于对比评测；
#                                  # off 不检索，search_knowledge 只回"未启用"
# 向量和 rerank 模型的来源：local（默认，本地约 4GB 内存）| siliconflow（硅基流动托管的同款模型，
# 目前免费，不占内存）。换来源后重新运行一次入库，全部小节会按新来源重算向量
# KNOWLEDGE_MODEL_PROVIDER=local
# SILICONFLOW_API_KEY=sk-...

# 可选：可观测（本地自建 Langfuse，见 deploy/langfuse/）。Public / Secret Key 都填了才启用；
# 本地的 Key 由 deploy/langfuse/init-env.sh 生成（.env 里的 LANGFUSE_INIT_PROJECT_*_KEY）
# LANGFUSE_BASE_URL=http://localhost:3100
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
