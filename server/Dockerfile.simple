# Simple standalone Dockerfile for CMDB verification
FROM golang:1.21-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Set working directory
WORKDIR /app

# Create a simple go.mod for our standalone server
RUN go mod init cmdb-simple

# Install only required dependencies
RUN go get github.com/gin-gonic/gin@latest

# Copy our simple server
COPY cmd/simple-server/main.go .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s" \
    -a -installsuffix cgo \
    -o cmdb-server main.go

# Final stage
FROM alpine:3.18

# Install runtime dependencies
RUN apk --no-cache add \
    ca-certificates \
    tzdata \
    bash \
    curl \
    && rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -g 1001 -S cmdb && \
    adduser -u 1001 -S cmdb -G cmdb

# Set working directory
WORKDIR /app

# Copy built binary from builder stage
COPY --from=builder /app/cmdb-server .

# Create necessary directories
RUN mkdir -p /app/data /app/logs && \
    chown -R cmdb:cmdb /app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Switch to non-root user
USER cmdb

# Expose port
EXPOSE 8080

# Default command
CMD ["./cmdb-server"]